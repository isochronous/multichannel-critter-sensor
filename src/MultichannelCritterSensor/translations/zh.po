msgid "All critters"
msgstr "全部小动物"

#. STRINGS.UI.UISIDESCREENS.MULTICHANNEL_CRITTER_SENSOR_SIDE_SCREEN.ALL_CRITTERS_TOOLTIP
msgctxt "STRINGS.UI.UISIDESCREENS.MULTICHANNEL_CRITTER_SENSOR_SIDE_SCREEN.ALL_CRITTERS_TOOLTIP"
msgid "Count every critter species, including ones discovered later"
msgstr "计算所有小动物物种，包括之后才发现的物种"

#. STRINGS.UI.UISIDESCREENS.MULTICHANNEL_CRITTER_SENSOR_SIDE_SCREEN.ALL_EGGS
